# cp .env.example .env && chmod 600 .env   (.env is gitignored; never commit it)
# Read by docker compose (this directory) AND by the register-agent / status scripts.

# ---- Payment Service (docker compose) ----
# Encrypts the wallet mnemonics in the database. At least 20 characters; generate with
#   openssl rand -hex 32
# NEVER change it after the first start: the node could no longer decrypt its wallets.
ENCRYPTION_KEY=
# Admin key (all permissions). At least 15 characters; generate with  openssl rand -hex 24
# It never leaves this laptop: the tunnel exposes only payment routes (gateway/gateway.mjs).
ADMIN_KEY=
# Blockfrost PREPROD project id (https://blockfrost.io, free). The seed stops without it.
# The same key also serves the MIP-003 Worker's reports (register-agent secrets).
BLOCKFROST_API_KEY_PREPROD=

# Optional. Leave blank and the seed generates fresh wallets and prints their mnemonics ONCE:
#   docker logs zyropay-masumi-payment-setup      <- save them immediately
PURCHASE_WALLET_PREPROD_MNEMONIC=
SELLING_WALLET_PREPROD_MNEMONIC=
# Keep BLANK. A collection address makes the node sign a sellerReturnAddress, which Sokosumi
# Coworker payments cannot carry. Without it, payouts land in the selling wallet.
COLLECTION_WALLET_PREPROD_ADDRESS=

# Fast preprod feedback (official quickstart defaults). Use 3+ confirmations on mainnet.
BLOCK_CONFIRMATIONS_THRESHOLD=0
CHECK_TX_INTERVAL=15
# Host port of the Payment Service (bound to 127.0.0.1 only).
MPS_PORT=3001

# ---- Registration (scripts/register-agent.ts) ----
# Your name or team name, shown on the registry entry and on Sokosumi. Required.
AGENT_AUTHOR_NAME=
# Optional contact email shown on the registry entry.
AGENT_AUTHOR_EMAIL=
# The MIP-003 Worker (apps/sokosumi-agent/mip003). Registered on chain as apiBaseUrl.
AGENT_API_BASE_URL=https://masumi-agent.zyropay.online
# Fixed price per report, in tUSDM (Sokosumi lists only USDM/tUSDM-priced agents).
AGENT_PRICE_TUSDM=1
# Where the scripts reach the Payment Service. Default http://127.0.0.1:${MPS_PORT}.
MPS_URL=
# Public URL the Worker uses. Leave blank: read from `docker logs zyropay-masumi-tunnel`.
PUBLIC_MPS_URL=
