{
  "name": "@zyropay/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres (Neon) schema, migrations and client factory.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "@zyropay/shared": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@zyropay/config": "workspace:*",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
