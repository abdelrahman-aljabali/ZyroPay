{
  // MIP-003 agent API for the Masumi registry (apiBaseUrl). README: "Masumi registration".
  // Deploy: pnpm --filter @zyropay/sokosumi-agent mip003:deploy
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "cardano-address-intel-masumi",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public URL (the registry's apiBaseUrl): https://masumi-agent.zyropay.online (custom domain).
  "routes": [{ "pattern": "masumi-agent.zyropay.online", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // All configuration is secret (wrangler secret bulk .local/mip003.secrets.json); see worker.mjs.
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "Jobs" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jobs"] }],
  "dev": { "port": 8791 },
}
