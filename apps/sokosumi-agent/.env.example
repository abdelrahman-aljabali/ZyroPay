# Copy to .env (gitignored) and chmod 600 .env. Never commit real values.

# Report data source (required): a Blockfrost PREPROD project id, https://blockfrost.io
BLOCKFROST_API_KEY_PREPROD=
# Optional Blockfrost-compatible base URL. Default: https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_BASE_URL=

# Sokosumi Coworker (required). From `sokosumi --preprod coworkers register ... --json`.
COWORKER_ID=
# Leave both blank for the Personal Workspace test; set both for the TUM Workspace.
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=

# Optional summary model (any OpenAI-compatible endpoint). Leave all blank for reports only.
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=

# Optional paid path (Masumi Payment Service from infrastructure/masumi, docker compose).
# Keep false until `pnpm --filter @zyropay/sokosumi-agent masumi:register` confirms.
PAID_TASKS_ENABLED=false
MPS_URL=http://127.0.0.1:3001
# Only for the template's local agent API (npm run api / npm run payment); the deployed MIP-003
# Worker (mip003/) replaces both.
AGENT_AUTHOR=
AGENT_API_PORT=21950
