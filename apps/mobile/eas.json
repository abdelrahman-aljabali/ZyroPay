{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "10.30.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_ZYROPAY_MODE": "development"
      },
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_ZYROPAY_MODE": "development",
        "EXPO_PUBLIC_USE_MOCKS": "0"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_ZYROPAY_MODE": "production",
        "EXPO_PUBLIC_USE_MOCKS": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
