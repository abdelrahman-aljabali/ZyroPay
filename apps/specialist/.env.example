# Cardano Token Intelligence (apps/specialist). Placeholders only: never commit real values.
# Copy to .dev.vars (read by `wrangler dev`). Git-ignored.

# payTo: this specialist's OWN preprod wallet (key-hash credential), not the Address
# Intelligence seller's: `pnpm --filter @zyropay/seller wallet specialist`.
SELLER_ADDRESS=addr_test1_REPLACE_ME
# Blockfrost preprod project id. Must start with "preprod".
# Deployed: `wrangler secret put BLOCKFROST_PROJECT_ID`.
BLOCKFROST_PROJECT_ID=preprod_REPLACE_ME
# Optional (defaults shown).
# PRICE_LOVELACE=1500000
# L1_CONFIRMATIONS=0
# FACILITATOR_MODE=embedded
# FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
# Delivery receipts: the payment signing key of SELLER_ADDRESS (hex).
# `pnpm --filter @zyropay/seller receipt-key specialist` writes apps/seller/.secrets/specialist.signing-key.
# SELLER_SIGNING_KEY=
