---
import { MARK_PATH, MARK_TILE_RADIUS } from "../lib/brand";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["mark", className]} viewBox="0 0 100 100" aria-hidden="true">
  <rect width="100" height="100" rx={MARK_TILE_RADIUS}></rect>
  <path d={MARK_PATH}></path>
</svg>
