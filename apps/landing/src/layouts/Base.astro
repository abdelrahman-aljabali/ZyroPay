---
import "../styles/base.css";
import AppLauncher from "../components/app/AppLauncher.tsx";

interface Props {
  title: string;
  description: string;
  /** Extra font files to preload (absolute paths under /fonts). */
  preload?: string[];
  themeColor?: string;
  bodyClass?: string;
  colorScheme?: "light" | "dark" | "light dark";
}

const {
  title,
  description,
  preload = [],
  themeColor = "#ffffff",
  bodyClass,
  colorScheme = "light",
} = Astro.props;
const fonts = ["/fonts/inter-var-opsz.woff2", ...preload];
const canonical = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1"),
  Astro.site,
).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content={colorScheme} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical.endsWith("/404") ? null : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZyroPay" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ZyroPay: Your AI asks. Your passkey decides. Cardano proves it. A delivery receipt stamped Verified on Cardano."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <AppLauncher client:idle />
  </body>
</html>
