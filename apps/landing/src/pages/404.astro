---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { APP_CTA, APP_URL } from "../lib/content";
import "../styles/plain.css";
---

<Base title="Not found · ZyroPay" description="This page does not exist." bodyClass="plain"
  themeColor="#060709"
  colorScheme="dark">
  <main id="main" class="plain__main">
    <a class="plain__back" href="/">
      <Mark />
      ZyroPay
    </a>
    <h1>Not found</h1>
    <p>This page does not exist. <a href="/">Back to the start</a>.</p>
    <a class="plain__app" href={APP_URL} data-open-app>{APP_CTA}</a>
  </main>
</Base>
