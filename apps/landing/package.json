{
  "name": "@zyropay/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing landing page (Astro + React islands), static assets on Cloudflare Workers. Owner: Brand.",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --env staging --port 8787",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "deploy": "echo \"Deploy with an environment: deploy:staging (pnpm deploy:landing from the root)\" && exit 1",
    "deploy:staging": "wrangler deploy --env staging",
    "qa:shots": "node scripts/qa-shots.mjs",
    "qa:mobile": "node scripts/qa-mobile.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "catalog:",
    "react-dom": "19.2.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "7.0.1",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/three": "0.186.0",
    "@zyropay/config": "workspace:*",
    "astro": "7.3.8",
    "eslint": "catalog:",
    "globals": "catalog:",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
