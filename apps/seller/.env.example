# Cardano Address Intelligence (apps/seller). Placeholders only: never commit real values.
# Copy to .dev.vars (read by `wrangler dev`) and/or .env (read by `pnpm buy`). Both are git-ignored.

# --- Seller (worker) ---------------------------------------------------------
# payTo: a PREPROD address (addr_test1...) whose payment credential is a key hash.
# Generate one with `pnpm --filter @zyropay/seller wallet seller`.
SELLER_ADDRESS=addr_test1_REPLACE_ME
# Blockfrost preprod project id (https://blockfrost.io). Must start with "preprod".
# Deployed: `wrangler secret put BLOCKFROST_PROJECT_ID`.
BLOCKFROST_PROJECT_ID=preprod_REPLACE_ME
# Optional (defaults shown).
# FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# PRICE_LOVELACE=2000000
# L1_CONFIRMATIONS=0
# BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
# Delivery receipts (optional): the payment signing key of SELLER_ADDRESS, hex.
# Generate with `pnpm --filter @zyropay/seller receipt-key` (writes .secrets/seller.signing-key).
# Deployed: `wrangler secret put SELLER_SIGNING_KEY < .secrets/seller.signing-key`.
# SELLER_SIGNING_KEY=
# Escrow route (GET /v1/address-report/escrow; needs SELLER_SIGNING_KEY). Defaults shown.
# ESCROW_PRICE_LOVELACE=5000000
# ESCROW_MAX_TIMEOUT_SECONDS=300
# ESCROW_SUBMIT_AFTER_PAYBY_MIN=10
# ESCROW_UNLOCK_AFTER_SUBMIT_MIN=15
# ESCROW_DISPUTE_AFTER_UNLOCK_MIN=15
# AUTO_AUTHORIZE_REFUNDS=true
# ESCROW_SCAN_PAGES=3
# Masumi registry identity the escrow 402s claim (its NFT must be held by SELLER_ADDRESS).
# MASUMI_AGENT_IDENTIFIER=
# "Dishonest seller" demo switch (OFF unless exactly "enabled"): allows ?demo=tamper or
# ?demo=nodelivery on the escrow route only. Never enable it for real buyers.
# DEMO_DISHONEST_MODE=enabled
# Sub-hiring Cardano Token Intelligence (apps/specialist). OFF unless SUBHIRE_ENABLED=true.
# SUBHIRE_ENABLED=true
# SPECIALIST_URL=http://localhost:8791
# Optional pin: only pay this payTo (the specialist's SELLER_ADDRESS).
# SPECIALIST_PAY_TO=addr_test1_REPLACE_ME
# Per-job cap, lovelace (1000000..3000000; default 3000000).
# SUBHIRE_MAX_LOVELACE=3000000
# Secret: the seller's own small budget wallet (`pnpm --filter @zyropay/seller wallet subhire`
# writes .secrets/subhire.mnemonic). NOT the payTo wallet.
# Deployed: `wrangler secret put SELLER_BUYER_MNEMONIC < .secrets/subhire.mnemonic`.
# SELLER_BUYER_MNEMONIC=

# --- Test buyer (`pnpm --filter @zyropay/seller buy --yes`) --------------------
# SELLER_URL=http://localhost:8790
# Default: read from .secrets/buyer.mnemonic (`pnpm --filter @zyropay/seller wallet buyer`).
# BUYER_MNEMONIC=
