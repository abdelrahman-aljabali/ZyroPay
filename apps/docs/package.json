{
  "name": "@zyropay/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public documentation site (Astro Starlight), static assets on Cloudflare Workers.",
  "scripts": {
    "dev": "node scripts/sync-generated.mjs && astro dev --port 4322",
    "build": "node scripts/sync-generated.mjs && node scripts/render-diagrams.mjs --check && astro build && node scripts/postbuild.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "preview": "wrangler dev --env staging --port 8788",
    "typecheck": "node scripts/sync-generated.mjs && astro check && tsc --noEmit",
    "lint": "eslint .",
    "deploy": "echo \"Deploy with an environment: deploy:staging\" && exit 1",
    "deploy:staging": "wrangler deploy --env staging",
    "qa:shots": "node scripts/qa-shots.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "catalog:",
    "@zyropay/config": "workspace:*",
    "eslint": "catalog:",
    "globals": "catalog:",
    "mermaid": "12.1.0",
    "playwright": "1.64.1",
    "starlight-links-validator": "0.27.0",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
