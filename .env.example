# =============================================================================
# ZyroPay environment variables. EVERY variable the system reads is listed here.
# Copy to .env (tooling), apps/api/.dev.vars and apps/mcp/.dev.vars (Workers, local).
# In deployed Workers, set secrets with `wrangler secret put NAME`; non-secrets go in
# wrangler.jsonc `vars`. Never commit real values.  [S] = secret.  Consumer in ().
# =============================================================================

# --- Runtime mode ------------------------------------------------------------
# development => testnets only (solana-devnet, ethereum-sepolia, base-sepolia)
# production  => mainnets only. The two are never mixed in one deployment.
ZYROPAY_MODE=development
# true => Mock* adapters (chain, prices, portfolio, on-ramp, plugins, push) and, without
# Turnkey credentials, MockTurnkey; every result is simulated:true. Development only: the
# API refuses to start with this true when ZYROPAY_MODE=production. With it false the API
# refuses to start unless Turnkey, DATABASE_URL, HELIUS_API_KEY and ALCHEMY_API_KEY are
# set (plus COINGECKO_API_KEY in production); /health names what is missing.
ZYROPAY_USE_MOCK_ADAPTERS=true
# Public base URLs (api, mcp). Used for OAuth metadata, deep links and webhooks.
API_PUBLIC_URL=http://localhost:8787
MCP_PUBLIC_URL=http://localhost:8788
# Deep-link scheme registered by the mobile app (approval links: zyropay://approvals/<id>).
APP_DEEP_LINK_SCHEME=zyropay
# Browser origins allowed by the API's CORS on /v1/* (comma-separated; empty = none). The
# native app sends no Origin. Internal and webhook routes never answer cross-origin. (api)
# The web app's exact origin, e.g. https://app.zyropay.example (`pnpm dev --web` sets
# http://localhost:8081 itself).
CORS_ALLOWED_ORIGINS=

# --- Database (Neon Postgres) -------------------------------------------------
# [S] (api, db migrations). `neon env pull` writes both into .env.local. Pooled URL
# (-pooler host) for the API; the direct URL for `pnpm db:migrate`. Local development:
# `pnpm db:local` runs Postgres 17 in Docker at postgres://zyropay:zyropay@127.0.0.1:55432/zyropay.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# neon (default): Neon's serverless driver (WebSockets; Neon only). pg: node-postgres over
# TCP for a plain local Postgres under `wrangler dev`. pg is refused in production. (api)
DATABASE_DRIVER=neon

# --- Turnkey ------------------------------------------------------------------
# Parent organization (dashboard.turnkey.com). One sub-organization per user.
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
# Parent-org API key pair for the API worker: read-only use against sub-orgs (wallet
# sync, whoami verification). It cannot sign for users (parent orgs cannot write to
# sub-orgs). [S] for the private key. (api)
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Auth Proxy config id (dashboard > Auth Proxy). Public; used by the mobile app for
# sub-org creation/sign-up without a backend. (mobile: EXPO_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID)
TURNKEY_AUTH_PROXY_CONFIG_ID=
# [S] 32-byte key, base64. AES-256-GCM key-encryption key for delegated-signer API
# private keys stored in delegated_signers (ADR-001). Rotate with re-encryption. (api)
DELEGATED_KEY_ENCRYPTION_KEY=

# --- Passkeys / app association -------------------------------------------------
# WebAuthn relying-party id: the domain that hosts apple-app-site-association and
# assetlinks.json. Must equal TurnkeyProvider passkeyConfig.rpId. (api, mobile)
PASSKEY_RP_ID=
PASSKEY_RP_NAME=ZyroPay
# Origin(s) accepted for passkey ceremonies, comma-separated (https://<rp id>, android:apk-key-hash:...).
PASSKEY_ALLOWED_ORIGINS=
# iOS: Apple Developer Team ID, used in apple-app-site-association (TEAMID.bundleid).
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
# Android: package name and SHA-256 signing-cert fingerprint(s) for assetlinks.json.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Sessions (API) ------------------------------------------------------------
# Access and refresh tokens are opaque random 256-bit tokens (zp_at_..., zp_rt_...); only
# their sha256 is stored, so there is no token-signing secret.
SESSION_ACCESS_TOKEN_TTL_SECONDS=900
SESSION_REFRESH_TOKEN_TTL_SECONDS=2592000
# [S] Salt for hashing client IPs in audit_logs.
AUDIT_IP_HASH_SALT=

# --- MCP server / OAuth ----------------------------------------------------------
# [S] >= 32 chars. HMAC key for the MCP authorize page's poll ticket. (mcp)
MCP_OAUTH_COOKIE_SECRET=
# OAuth tokens are opaque and stored hashed in OAUTH_KV by the workers-oauth-provider;
# there is no token-signing secret. Access-token lifetime, 60..3600 (default 900). (mcp)
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Extra browser origins allowed to call /mcp, comma-separated (the worker's own origin and
# claude.ai, claude.com, chatgpt.com, grok.com are always allowed). (mcp)
MCP_ALLOWED_ORIGINS=
# log (default): audit events go to Workers Logs. api: also POST /internal/v1/audit-events. (mcp)
MCP_AUDIT_SINK=log
# How long the user has to confirm an agent connection code in the app.
AGENT_CONNECTION_CODE_TTL_SECONDS=600

# --- Internal service auth (MCP -> API) -------------------------------------------
# [S] Shared bearer token; the ONLY credential the MCP worker has toward the API.
# Same value in both workers. Rotate by deploying the API with both old+new first.
INTERNAL_SERVICE_TOKEN=
INTERNAL_SERVICE_TOKEN_PREVIOUS=
# Local development only: base URLs for worker-to-worker calls when the services run as
# separate `wrangler dev` processes. Deployed workers use service bindings (API <-> MCP)
# and leave these unset. (mcp: API_INTERNAL_URL; api: MCP_INTERNAL_URL)
API_INTERNAL_URL=http://localhost:8787
MCP_INTERNAL_URL=http://localhost:8788

# --- Chain data -----------------------------------------------------------------
# [S] Helius (Solana RPC, DAS, webhooks). (api / packages/blockchain)
HELIUS_API_KEY=
# [S] Optional failover keys (another Helius account or plan). When a key answers 401/403 or
# 429 ("max usage reached"), that request is replayed with the next key and the failing key
# rests (in-isolate memory: 1 h for spent credits, 15 min for 401/403, ~10 s for rate limits).
# Order: HELIUS_API_KEY, HELIUS_API_KEY_SECONDARY, then HELIUS_API_KEYS (comma-separated).
HELIUS_API_KEY_SECONDARY=
HELIUS_API_KEYS=
# [S] Verifies Helius webhook auth header.
HELIUS_WEBHOOK_SECRET=
# [S] Alchemy (Ethereum + Base RPC, token balances, transfers).
ALCHEMY_API_KEY=
# [S] Verifies Alchemy Notify webhook signatures.
ALCHEMY_WEBHOOK_SIGNING_KEY=
# [S] Blockfrost (Cardano: UTxOs, balances, history, protocol parameters, tx/submit).
# One project per network (https://blockfrost.io/dashboard); ids start with the network name.
# Production reads ONLY the mainnet id, development ONLY the preprod id; a crossed id refuses
# to start. Without the id for the mode, Cardano is not served (requests fail
# NETWORK_NOT_SUPPORTED, balances omit it); the rest of the deployment is unaffected.
BLOCKFROST_PROJECT_ID_MAINNET=
BLOCKFROST_PROJECT_ID_PREPROD=
# Confirmation policy.
EVM_CONFIRMATIONS=2
SOLANA_COMMITMENT=confirmed
# Blocks (including the inclusion block) before a Cardano transaction counts as confirmed.
CARDANO_CONFIRMATIONS=3

# --- Prices ---------------------------------------------------------------------
# Solana mainnet prices: Jupiter Price API (JUPITER_API_KEY). Ethereum/Base: CoinGecko.
# [S] CoinGecko API key; required in production. COINGECKO_PLAN = demo | pro.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo
# Prices older than this are flagged stale; valuations then fail closed (approval needed).
PRICE_MAX_AGE_SECONDS=120
# Development only, default true there: value testnet SOL/ETH/ADA and curated testnet USDC
# at their mainnet counterparts' prices, labelled priceBasis "mainnet_proxy" ("testnet ·
# mainnet price" in the app). Needed for testnet USD limits and autonomous mode. Production
# refuses to start with it true. Unknown testnet tokens stay unpriced (fail closed).
# (PRICE_TESTNET_PROXY is the deprecated alias.)
VALUE_TESTNETS_AT_MAINNET_PRICES=true

# --- Plugins ----------------------------------------------------------------------
# [S] Jupiter API key (api.jup.ag): swaps (mainnet only) and Solana prices.
JUPITER_API_KEY=
# x402 facilitator (verify/settle), from the plugin manifest; the resource server settles.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Hard per-payment x402 caps: JSON {assetId: maxBaseUnits}. An asset without a cap is never
# paid, whatever the agent's maxAmount says. Example (1 USDC on Base Sepolia):
#   X402_CAPS={"base-sepolia:0x036CbD53842c5426634e7929541eC2318f3dCF7e":"1000000"}
X402_CAPS={}
# Refuse x402 requirements asking for a longer validity window (seconds).
X402_MAX_TIMEOUT_SECONDS=600
# Register the coming_soon plugin adapters (Kamino, Aave, Hyperliquid). They stay
# unavailable to users until their manifests are marked available.
PLUGINS_ENABLE_COMING_SOON=false

# --- On-ramp (Transak; sandbox in development) ----------------------------------------
# STAGING (testnets) exactly when ZYROPAY_MODE=development, PRODUCTION otherwise.
# Without TRANSAK_API_KEY/SECRET the on-ramp endpoints refuse (no mock in real mode).
TRANSAK_ENVIRONMENT=STAGING
# Domain registered with Transak (default: API_PUBLIC_URL's host).
TRANSAK_REFERRER_DOMAIN=
TRANSAK_API_KEY=
# [S]
TRANSAK_API_SECRET=
# [S] Verifies Transak webhook payloads.
TRANSAK_WEBHOOK_SECRET=

# --- Push notifications ---------------------------------------------------------------
# [S] Optional Expo access token (required only if enhanced push security is enabled).
EXPO_ACCESS_TOKEN=
# Expo/EAS project id (public).
EXPO_PROJECT_ID=

# --- Tests ----------------------------------------------------------------------------------
# Optional: a Postgres URL whose role may CREATE DATABASE. When set, apps/api's real-Postgres
# concurrency tests run (each run uses and drops a throwaway database). CI sets it.
TEST_DATABASE_URL=
# Optional: the same kind of URL for `pnpm smoke` (tests/integration/e2e-smoke). Without it
# the smoke starts its own throwaway postgres:17 container in Docker.
SMOKE_DATABASE_URL=
# Host port of the `pnpm db:local` / `pnpm dev` Docker Postgres (default 55432).
ZYROPAY_DEV_PG_PORT=55432

# --- Observability ------------------------------------------------------------------------
# Sentry DSNs are not secret but are per-project (docs/MONITORING.md). Empty = Sentry off.
# Workers: set with `wrangler secret put` (or .dev.vars). The app reads its DSN at build
# time as EXPO_PUBLIC_SENTRY_DSN (set it to the SENTRY_DSN_MOBILE value; native and web).
SENTRY_DSN_API=
SENTRY_DSN_MCP=
SENTRY_DSN_MOBILE=
SENTRY_ENVIRONMENT=development
# Optional: release name attached to worker events (e.g. the git sha).
SENTRY_RELEASE=
# [S] Only for CI source-map upload.
SENTRY_AUTH_TOKEN=
# PostHog project key (public) and host.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Mobile app (Expo exposes only EXPO_PUBLIC_*; never put secrets here) -------------------
# Put these in apps/mobile/.env (Expo reads it). `pnpm dev` sets the first four for you.
# API base URL. On a phone use your computer's LAN address (pnpm dev does), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
# MCP server URL shown on the agent-connect screens.
EXPO_PUBLIC_MCP_URL=http://localhost:8788/mcp
# 1 = in-app mock transport (simulated data, no backend; refused in production).
EXPO_PUBLIC_USE_MOCKS=0
# mock-turnkey = sign with a development `dev-*` passkey that a local API running MockTurnkey
# (no Turnkey credentials) accepts. Lets Expo Go use a real local API. Development only.
EXPO_PUBLIC_DEV_PASSKEY=
# development (testnets) | production (mainnets). Must match the API's ZYROPAY_MODE.
EXPO_PUBLIC_ZYROPAY_MODE=development
# Turnkey (React Native Wallet Kit). All three of ORGANIZATION_ID, AUTH_PROXY_CONFIG_ID and
# PASSKEY_RP_ID are needed for real passkeys, in a development build (not Expo Go).
EXPO_PUBLIC_TURNKEY_API_BASE_URL=https://api.turnkey.com
EXPO_PUBLIC_TURNKEY_ORGANIZATION_ID=
EXPO_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Web app: the site's host or a registrable parent (`localhost` for http://localhost:8081).
EXPO_PUBLIC_PASSKEY_RP_ID=
EXPO_PUBLIC_PASSKEY_RP_NAME=ZyroPay
# URL scheme for deep links (zyropay://approvals/<id>); keep equal to APP_DEEP_LINK_SCHEME.
EXPO_PUBLIC_DEEP_LINK_SCHEME=zyropay
# Build time (apps/mobile/app.config.ts, EAS): development | preview | production. Sets the
# bundle/package suffix (.dev, .preview) and the app name.
APP_VARIANT=development
# Expo account that owns the EAS project, and the EAS project id (push tokens and updates
# need EXPO_PROJECT_ID, listed under push notifications above).
EXPO_OWNER=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
